{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Music",
  "version": "0.4.1",
  "identifier": "io.github.neverh8me.ytmusic",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Music",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#050507",
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling,MediaSessionService --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob:",
        "media-src": "'self' http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQjA0QzlGNDY2RUJFOTUKUldTVnZtNUduMHl3Vzlqc2M1bWZ4MXFDa0JzMlpNeDJGQ0VVVDl5QVcyWTc0eDdlakFyRUhxL0EK",
      "endpoints": ["https://github.com/neverh8me/yt-music/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "neverh8me",
    "copyright": "GPL-3.0. Unofficial; not affiliated with Google LLC.",
    "category": "Music",
    "shortDescription": "Fast unofficial YouTube Music client",
    "longDescription": "A fast, unofficial YouTube Music client written in Rust: search, streaming, library, lyrics and offline downloads.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
